---
import PaginaProyecto from '../../components/PaginaProyecto.astro';
import { proyectosDe, siguienteDe } from '../../proyectos';

export async function getStaticPaths() {
  const lista = await proyectosDe('es');
  // «Siguiente proyecto» dentro del mismo grupo (proyectos grandes o ingeniería inversa)
  return lista.map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto, siguiente: siguienteDe(lista, proyecto) },
  }));
}
const { proyecto, siguiente } = Astro.props;
---
<PaginaProyecto lang="es" proyecto={proyecto} siguiente={siguiente} />
