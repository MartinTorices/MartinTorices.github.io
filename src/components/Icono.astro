---
// Iconos de trazo sencillo (24x24)
interface Props { nombre: 'correo' | 'linkedin' | 'telefono' | 'whatsapp' | 'descarga' | 'flecha-izq' | 'expandir' | 'pausa' | 'play' }
const { nombre } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nombre === 'correo' && (<><rect x="3" y="5" width="18" height="14" /><path d="m3 6 9 7 9-7" /></>)}
  {nombre === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" /><path d="M8 10v7M8 7v.01M12 17v-7M12 13a3 3 0 0 1 6 0v4" /></>)}
  {nombre === 'telefono' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {nombre === 'whatsapp' && (<><path d="M3 21l1.65-3.8A9 9 0 1 1 8.4 20.5L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" /></>)}
  {nombre === 'descarga' && (<><path d="M12 4v11M7 10l5 5 5-5" /><path d="M4 20h16" /></>)}
  {nombre === 'flecha-izq' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {nombre === 'expandir' && <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />}
  {nombre === 'pausa' && <path d="M9 5v14M15 5v14" />}
  {nombre === 'play' && <path d="M8 5l11 7-11 7z" />}
  {nombre === 'luz' && (<><path d="M9 18h6M10 21h4" /><path d="M8.5 15a6 6 0 1 1 7 0c-.6.5-1 1.2-1 2h-5c0-.8-.4-1.5-1-2" /></>)}
</svg>
