---
// Visor 3D interactivo (model-viewer de Google).
// Uso: <Visor3D src="/modelos/mi-pieza.glb" alt="..." lang="es" />
import { t, type Lang } from '../i18n';
import Icono from './Icono.astro';

interface Props {
  src: string;
  alt: string;
  lang: Lang;
  poster?: string;
  // Opcional: varias versiones del modelo que el visitante puede elegir
  variantes?: { nombre: string; src: string; orbita?: string }[];
  etiquetaVariantes?: string;
  // Opcional: acabados (KHR_materials_variants del .glb) y botón de luz (materiales «luz_…»)
  acabados?: { nombre: string; variante: string }[];
  etiquetaAcabados?: string;
  interruptorLuz?: boolean;
}
const { src, alt, lang, poster, variantes = [], etiquetaVariantes, acabados = [], etiquetaAcabados, interruptorLuz = false } = Astro.props;
const tx = t(lang);

---

<figure class="visor" data-visor>
  <div class="visor__marco">
    <model-viewer
      src={src}
      alt={alt}
      poster={poster}
      camera-controls
      camera-orbit="32deg 72deg auto"
      touch-action="pan-y"
      auto-rotate
      auto-rotate-delay="1500"
      rotation-per-second="18deg"
      interaction-prompt="none"
      shadow-intensity="0.85"
      shadow-softness="0.75"
      exposure="1"
      tone-mapping="neutral"
      environment-image="/modelos/estudio.hdr"
    >
      <div slot="progress-bar" class="visor__carga nota">{tx.vista3dCargando}</div>
    </model-viewer>
    {variantes.length > 1 && (
      <div class="visor__variantes" role="group" aria-label={etiquetaVariantes}>
        {etiquetaVariantes && <span class="visor__variantes-titulo">{etiquetaVariantes}</span>}
        {variantes.map((v) => (
          <button type="button" class="visor__variante" data-src={v.src} data-orbita={v.orbita} aria-pressed={v.src === src ? 'true' : 'false'}>
            {v.nombre}
          </button>
        ))}
      </div>
    )}
    {(acabados.length > 1 || interruptorLuz) && (
      <div class="visor__abajo">
        {acabados.length > 1 && (
          <div class="visor__grupo" role="group" aria-label={etiquetaAcabados}>
            {etiquetaAcabados && <span class="visor__variantes-titulo">{etiquetaAcabados}</span>}
            {acabados.map((a, i) => (
              <button type="button" class="visor__variante visor__acabado" data-variante={a.variante} aria-pressed={i === 0 ? 'true' : 'false'}>
                {a.nombre}
              </button>
            ))}
          </div>
        )}
        {interruptorLuz && (
          <button class="boton visor__luz" type="button" data-luz data-apagar={tx.apagarLuz} data-encender={tx.encenderLuz} aria-pressed="true">
            <Icono nombre="luz" />
            <span>{tx.apagarLuz}</span>
          </button>
        )}
      </div>
    )}
    <button class="boton visor__anim" type="button" data-anim hidden data-pausar={tx.pausar} data-reanudar={tx.reanudar} aria-pressed="false">
      <span class="visor__anim-icono" data-icono="pausa"><Icono nombre="pausa" /></span>
      <span class="visor__anim-icono" data-icono="play" hidden><Icono nombre="play" /></span>
      <span data-texto>{tx.pausar}</span>
    </button>
    <button class="boton visor__pantalla" type="button" data-pantalla data-entrar={tx.pantallaCompleta} data-salir={tx.salirPantallaCompleta}>
      <Icono nombre="expandir" />
      <span>{tx.pantallaCompleta}</span>
    </button>
  </div>
  <figcaption class="nota">
    <strong>{tx.vista3d}.</strong>{' '}{tx.vista3dAyuda}
  </figcaption>
</figure>

<script>
  import { ModelViewerElement } from '@google/model-viewer';

  // Calidad: model-viewer baja la resolución si cree que el equipo va justo; así
  // siempre dibuja a la resolución completa de la pantalla (también los visores del texto)
  (ModelViewerElement as any).minimumRenderScale = 1;

  document.querySelectorAll<HTMLElement>('[data-visor]').forEach((visor) => {
    const mv = visor.querySelector('model-viewer')!;
    const carga = visor.querySelector<HTMLElement>('.visor__carga');
    mv.addEventListener('load', () => carga?.remove());
    // Modelos animados (p. ej. el dosificador en funcionamiento): se reproducen en
    // bucle, sin girar solos, y con un botón para pausar
    const anim = visor.querySelector<HTMLButtonElement>('[data-anim]')!;
    const animTexto = anim.querySelector<HTMLElement>('[data-texto]')!;
    const giraSolo = mv.hasAttribute('auto-rotate');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pintarAnim = (enMarcha: boolean) => {
      animTexto.textContent = enMarcha ? anim.dataset.pausar! : anim.dataset.reanudar!;
      anim.setAttribute('aria-pressed', String(!enMarcha));
      anim.querySelector<HTMLElement>('[data-icono="pausa"]')!.hidden = !enMarcha;
      anim.querySelector<HTMLElement>('[data-icono="play"]')!.hidden = enMarcha;
    };
    // Acabado elegido y luz encendida o apagada: se mantienen al cambiar de versión
    let acabado: string | null = null;
    let luz = true;
    const aplicarLuz = () => {
      const m = mv as any;
      for (const mat of m.model?.materials ?? []) {
        if (!mat.name?.startsWith('luz_')) continue;
        mat.__original ??= [...mat.emissiveFactor];
        mat.setEmissiveFactor(luz ? mat.__original : [0, 0, 0]);
      }
    };
    mv.addEventListener('load', () => {
      const m = mv as any;
      if (acabado && m.availableVariants?.includes(acabado)) m.variantName = acabado;
      aplicarLuz();
    });
    visor.querySelectorAll<HTMLButtonElement>('.visor__acabado').forEach((b) => {
      b.addEventListener('click', () => {
        acabado = b.dataset.variante!;
        (mv as any).variantName = acabado;
        visor.querySelectorAll('.visor__acabado').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      });
    });
    const botonLuz = visor.querySelector<HTMLButtonElement>('[data-luz]');
    botonLuz?.addEventListener('click', () => {
      luz = !luz;
      aplicarLuz();
      botonLuz.setAttribute('aria-pressed', String(luz));
      botonLuz.querySelector('span')!.textContent = luz ? botonLuz.dataset.apagar! : botonLuz.dataset.encender!;
    });
    mv.addEventListener('load', () => {
      const m = mv as any;
      const animado = (m.availableAnimations?.length ?? 0) > 0;
      anim.hidden = !animado;
      m.autoRotate = giraSolo && !animado;
      if (animado) {
        if (quieto) m.pause(); else m.play({ repetitions: Infinity });
        pintarAnim(!quieto);
      }
    });
    anim.addEventListener('click', () => {
      const m = mv as any;
      if (m.paused) m.play({ repetitions: Infinity }); else m.pause();
      pintarAnim(!m.paused);
    });
    // Cambiar de versión del modelo sin mover el ángulo de la cámara
    // (la distancia se recalcula: cada versión puede ocupar más o menos)
    visor.querySelectorAll<HTMLButtonElement>('.visor__variante:not(.visor__acabado)').forEach((b) => {
      b.addEventListener('click', () => {
        const orbita = (mv as any).getCameraOrbit?.();
        mv.setAttribute('src', b.dataset.src!);
        mv.addEventListener('load', () => {
          const m = mv as any;
          m.cameraTarget = 'auto auto auto';
          // la vista animada empieza en el ángulo inicial (el movimiento se ve de perfil)
          if (b.dataset.orbita) m.cameraOrbit = b.dataset.orbita;
          else if ((m.availableAnimations?.length ?? 0) > 0) m.cameraOrbit = mv.getAttribute('camera-orbit');
          else if (orbita) m.cameraOrbit = `${orbita.theta}rad ${orbita.phi}rad auto`;
          m.jumpCameraToGoal?.();
        }, { once: true });
        visor.querySelectorAll('.visor__variante:not(.visor__acabado)').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      });
    });
    const boton = visor.querySelector<HTMLButtonElement>('[data-pantalla]')!;
    const marco = visor.querySelector<HTMLElement>('.visor__marco')!;
    const texto = boton.querySelector('span')!;
    if (!document.fullscreenEnabled) {
      boton.hidden = true;
      return;
    }
    boton.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else marco.requestFullscreen();
    });
    document.addEventListener('fullscreenchange', () => {
      const dentro = document.fullscreenElement === marco;
      texto.textContent = dentro ? boton.dataset.salir! : boton.dataset.entrar!;
    });
  });
</script>

<style>
  .visor {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .visor__marco {
    position: relative;
    /* el modelo se ve sobre una lámina clara: el aluminio oscuro no se pierde */
    border: var(--trazo-grueso) solid var(--lamina-fondo);
    background: var(--lamina-fondo);
    aspect-ratio: 16 / 10;
  }
  .visor__marco:fullscreen {
    border: 0;
    background: var(--lamina-fondo);
    aspect-ratio: auto;
  }
  model-viewer {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
    background: transparent;
  }
  .visor__carga {
    position: absolute;
    left: 1rem;
    top: 1rem;
  }
  .visor__pantalla {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    background: var(--papel);
    font-size: var(--t-0);
  }
  .visor__anim {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    background: var(--papel);
    font-size: var(--t-0);
  }
  .visor__anim[hidden],
  .visor__anim-icono[hidden] {
    display: none;
  }
  .visor__anim-icono {
    display: inline-flex;
  }
  .visor__variantes {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
  }
  .visor__abajo {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem;
    max-width: calc(100% - 9.5rem);
  }
  .visor__luz {
    background: var(--papel);
    font-size: var(--t-0);
  }
  .visor__luz[aria-pressed='true'] :global(svg) {
    color: var(--azul);
  }
  /* los botones del visor llevan fondo propio: al pasar el ratón, se invierten */
  .visor__marco .boton:hover {
    background: var(--tinta);
    color: var(--papel);
  }
  .visor__marco .boton:hover :global(svg) {
    color: inherit;
  }
  .visor__variantes,
  .visor__grupo {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border: var(--trazo) solid var(--tinta);
    background: var(--papel);
    font-size: var(--t-0);
    max-width: calc(100% - 4.5rem);
  }
  .visor__variantes-titulo {
    padding: 0.5em 0.8em;
    font-stretch: 80%;
    color: var(--tinta-suave);
    border-right: var(--trazo) solid var(--tinta);
    display: flex;
    align-items: center;
  }
  .visor__variante {
    font: inherit;
    font-weight: 600;
    font-stretch: 100%;
    padding: 0.5em 0.9em;
    border: 0;
    border-right: var(--trazo) solid var(--tinta);
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
  }
  .visor__variante:last-child {
    border-right: 0;
  }
  .visor__variante:hover {
    color: var(--azul);
  }
  .visor__variante[aria-pressed='true'] {
    background: var(--azul);
    color: var(--papel);
  }
  @media (max-width: 40rem) {
    .visor__marco {
      aspect-ratio: 1 / 1;
    }
    /* en el móvil: la luz encima y los acabados en una sola fila, sin rótulo */
    .visor__abajo {
      flex-direction: column-reverse;
      align-items: flex-start;
      max-width: calc(100% - 1.5rem);
    }
    .visor__grupo {
      flex-wrap: nowrap;
      max-width: none;
    }
    .visor__grupo .visor__variantes-titulo {
      display: none;
    }
    .visor__pantalla span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
