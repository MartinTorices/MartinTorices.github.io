---
// Visor 3D interactivo (model-viewer de Google).
// Uso: <Visor3D src="/modelos/mi-pieza.glb" alt="..." lang="es" />
import fs from 'node:fs';
import path from 'node:path';
import { t, type Lang } from '../i18n';
import Icono from './Icono.astro';

interface Props {
  src: string;
  alt: string;
  lang: Lang;
  poster?: string;
  // Opcional: varias versiones del modelo que el visitante puede elegir
  variantes?: { nombre: string; src: string }[];
  etiquetaVariantes?: string;
}
const { src, alt, lang, poster, variantes = [], etiquetaVariantes } = Astro.props;
const tx = t(lang);
// Realidad aumentada en el iPhone (AR Quick Look): si junto al .glb hay un .usdz
// con el mismo nombre (herramientas/usdz.py), se usa; si no, model-viewer lo genera al vuelo.
const usdz = (glb: string) => {
  const u = glb.replace(/\.glb$/, '.usdz');
  return fs.existsSync(path.join(process.cwd(), 'public', u)) ? u : undefined;
};
---

<figure class="visor" data-visor>
  <div class="visor__marco">
    <model-viewer
      src={src}
      alt={alt}
      poster={poster}
      camera-controls
      camera-orbit="32deg 72deg auto"
      touch-action="pan-y"
      auto-rotate
      auto-rotate-delay="1500"
      rotation-per-second="18deg"
      interaction-prompt="none"
      shadow-intensity="0.85"
      shadow-softness="0.75"
      exposure="1"
      tone-mapping="neutral"
      environment-image="/modelos/estudio.hdr"
      ar
      ar-modes="scene-viewer webxr quick-look"
      ar-scale="auto"
      ar-placement="floor"
      ios-src={usdz(src)}
    >
      <div slot="progress-bar" class="visor__carga nota">{tx.vista3dCargando}</div>
      <button slot="ar-button" class="boton visor__ar">{tx.verEnAR}</button>
    </model-viewer>
    {variantes.length > 1 && (
      <div class="visor__variantes" role="group" aria-label={etiquetaVariantes}>
        {etiquetaVariantes && <span class="visor__variantes-titulo">{etiquetaVariantes}</span>}
        {variantes.map((v) => (
          <button type="button" class="visor__variante" data-src={v.src} data-ios-src={usdz(v.src)} aria-pressed={v.src === src ? 'true' : 'false'}>
            {v.nombre}
          </button>
        ))}
      </div>
    )}
    <button class="boton visor__pantalla" type="button" data-pantalla data-entrar={tx.pantallaCompleta} data-salir={tx.salirPantallaCompleta}>
      <Icono nombre="expandir" />
      <span>{tx.pantallaCompleta}</span>
    </button>
  </div>
  <figcaption class="nota">
    <strong>{tx.vista3d}.</strong>{' '}{tx.vista3dAyuda}
  </figcaption>
</figure>

<script>
  import { ModelViewerElement } from '@google/model-viewer';

  // Calidad: model-viewer baja la resolución si cree que el equipo va justo; así
  // siempre dibuja a la resolución completa de la pantalla (también los visores del texto)
  (ModelViewerElement as any).minimumRenderScale = 1;

  document.querySelectorAll<HTMLElement>('[data-visor]').forEach((visor) => {
    const mv = visor.querySelector('model-viewer')!;
    const carga = visor.querySelector<HTMLElement>('.visor__carga');
    mv.addEventListener('load', () => carga?.remove());
    // Cambiar de versión del modelo sin mover la cámara
    visor.querySelectorAll<HTMLButtonElement>('.visor__variante').forEach((b) => {
      b.addEventListener('click', () => {
        const orbita = (mv as any).getCameraOrbit?.();
        mv.setAttribute('src', b.dataset.src!);
        // la realidad aumentada del iPhone también pasa a la balda elegida
        if (b.dataset.iosSrc) mv.setAttribute('ios-src', b.dataset.iosSrc);
        else mv.removeAttribute('ios-src');
        mv.addEventListener('load', () => {
          if (orbita) (mv as any).cameraOrbit = orbita.toString();
        }, { once: true });
        visor.querySelectorAll('.visor__variante').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      });
    });
    const boton = visor.querySelector<HTMLButtonElement>('[data-pantalla]')!;
    const marco = visor.querySelector<HTMLElement>('.visor__marco')!;
    const texto = boton.querySelector('span')!;
    if (!document.fullscreenEnabled) {
      boton.hidden = true;
      return;
    }
    boton.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else marco.requestFullscreen();
    });
    document.addEventListener('fullscreenchange', () => {
      const dentro = document.fullscreenElement === marco;
      texto.textContent = dentro ? boton.dataset.salir! : boton.dataset.entrar!;
    });
  });
</script>

<style>
  .visor {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .visor__marco {
    position: relative;
    /* el modelo se ve sobre una lámina clara: el aluminio oscuro no se pierde */
    border: var(--trazo-grueso) solid var(--lamina-fondo);
    background: var(--lamina-fondo);
    aspect-ratio: 16 / 10;
  }
  .visor__marco:fullscreen {
    border: 0;
    background: var(--lamina-fondo);
    aspect-ratio: auto;
  }
  model-viewer {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
    background: transparent;
  }
  .visor__carga {
    position: absolute;
    left: 1rem;
    top: 1rem;
  }
  .visor__pantalla {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    background: var(--papel);
    font-size: var(--t-0);
  }
  .visor__variantes {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border: var(--trazo) solid var(--tinta);
    background: var(--papel);
    font-size: var(--t-0);
    max-width: calc(100% - 4.5rem);
  }
  .visor__variantes-titulo {
    padding: 0.5em 0.8em;
    font-stretch: 80%;
    color: var(--tinta-suave);
    border-right: var(--trazo) solid var(--tinta);
    display: flex;
    align-items: center;
  }
  .visor__variante {
    font: inherit;
    font-weight: 600;
    font-stretch: 100%;
    padding: 0.5em 0.9em;
    border: 0;
    border-right: var(--trazo) solid var(--tinta);
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
  }
  .visor__variante:last-child {
    border-right: 0;
  }
  .visor__variante:hover {
    color: var(--azul);
  }
  .visor__variante[aria-pressed='true'] {
    background: var(--azul);
    color: var(--papel);
  }
  .visor__ar {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    background: var(--papel);
    font-size: var(--t-0);
  }
  @media (max-width: 40rem) {
    .visor__marco {
      aspect-ratio: 1 / 1;
    }
    .visor__pantalla span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
