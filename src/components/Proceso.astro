---
// Franja «De la idea a la fabricación»: las fases con las que trabaja Martín,
// unidas por una línea de cota. Es una secuencia, por eso va numerada.
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const fases = lang === 'es'
  ? [['Idea', 'Problema, usuario y requisitos'], ['Boceto', 'Alternativas a mano y elección'], ['CAD', 'Modelado paramétrico y planos'], ['Prototipo', 'Maqueta, pruebas y ajustes'], ['Fabricación', 'Materiales, procesos y costes']]
  : [['Idea', 'Problem, user and requirements'], ['Sketch', 'Hand-drawn options and choice'], ['CAD', 'Parametric modelling and drawings'], ['Prototype', 'Mock-ups, tests and tweaks'], ['Manufacturing', 'Materials, processes and costs']];
---
<section class="proceso" id="proceso" data-revelar aria-label={lang === 'es' ? 'Cómo trabajo' : 'How I work'}>
  <ol class="contenedor fases">
    {fases.map(([t, d], i) => (
      <li style={`--n:${i}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><strong>{t}</strong><span class="d">{d}</span></li>
    ))}
  </ol>
</section>
<style>
  /* Fondo fundido: el carbón de la portada se aclara poco a poco hasta la banda */
  .proceso { position: relative; isolation: isolate; padding-block: 2.5rem; }
  .proceso::before {
    content: '';
    position: absolute;
    inset: -10rem 0 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--papel) 0%, var(--banda) 70%, var(--banda) 100%);
  }
  .fases { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 0; position: relative; }
  .fases::before { content: ''; position: absolute; left: calc(var(--gutter) + var(--hueco, 0px)); right: var(--gutter); top: 0.55rem; border-top: 1px solid var(--azul); }
  li { position: relative; padding: 1.6rem 1rem 0 0; display: grid; gap: 0.25rem; align-content: start; }
  li::before { content: ''; position: absolute; top: 0.25rem; left: 0; width: 9px; height: 9px; background: var(--azul); }
  .n { font-size: var(--t-0); color: var(--azul); font-weight: 700; font-variant-numeric: tabular-nums; }
  strong { font-size: var(--t-3); font-stretch: 115%; font-weight: 750; }
  /* Con el índice lateral al lado, las columnas son más estrechas: el título se ajusta
     al ancho de su columna para que «Fabricación» o «Manufacturing» no se salgan */
  @media (min-width: 60rem) {
    li { container-type: inline-size; }
    strong { font-size: min(var(--t-3), 11.5cqi); font-stretch: 105%; }
  }
  .d { color: var(--tinta-suave); font-size: var(--t-0); }
  /* En pantallas estrechas, la cota pasa a ser vertical */
  @media (max-width: 50rem) {
    .fases { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .fases::before { left: calc(var(--gutter) + 4px); right: auto; top: 0.5rem; bottom: 0.5rem; border-top: 0; border-left: 1px solid var(--azul); }
    li { padding: 0 0 0 1.75rem; }
    li::before { top: 0.35rem; }
    .fases::before { transform-origin: top; }
  }
  /* Al llegar con el scroll: la cota se traza y las fases aparecen en orden */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .fases::before {
      scale: 0 1;
      transform-origin: left;
      transition: scale 1.2s cubic-bezier(0.6, 0, 0.2, 1);
    }
    :global(.js) li {
      opacity: 0;
      translate: 0 1rem;
      transition: opacity 0.6s ease, translate 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(var(--n) * 0.18s + 0.15s);
    }
    :global(.js) li::before {
      scale: 0;
      transition: scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      transition-delay: calc(var(--n) * 0.18s + 0.15s);
    }
    :global(.js) .visible .fases::before { scale: 1 1; }
    :global(.js) .visible li { opacity: 1; translate: none; }
    :global(.js) .visible li::before { scale: 1; }
    @media (max-width: 50rem) {
      :global(.js) .fases::before { scale: 1 0; transform-origin: top; }
    }
  }
</style>
