---
// Página con la galería de todos los proyectos
import Base from '../layouts/Base.astro';
import TarjetaProyecto from './TarjetaProyecto.astro';
import { proyectosDe } from '../proyectos';
import { t, rutas, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = t(lang);
const proyectos = await proyectosDe(lang);
const otro: Lang = lang === 'es' ? 'en' : 'es';
---

<Base lang={lang} titulo={tx.proyectosTitulo} descripcion={tx.proyectosIntro} alternativa={rutas.proyectos(otro)}>
  <section class="contenedor proyectos" aria-labelledby="proyectos-t">
    <header class="cabeza">
      <h1 id="proyectos-t" class="titulo-seccion" data-aparecer>{tx.proyectosTitulo}</h1>
      <p class="entradilla" data-aparecer style="--retraso:0.1s">{tx.proyectosIntro}</p>
    </header>
    {proyectos.length === 0 ? (
      <p>{tx.proyectosVacio}</p>
    ) : (
      <div class="galeria">
        {proyectos.map((p, i) => <TarjetaProyecto proyecto={p} prioridad={i < 4} indice={i} />)}
      </div>
    )}
  </section>
</Base>

<style>
  .proyectos {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
    min-height: calc(100svh - 8rem);
  }
  .cabeza h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .cabeza h1::after {
    transform: translateY(-0.2em);
  }
  .entradilla {
    margin-top: 1rem;
  }
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
