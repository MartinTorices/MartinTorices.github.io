---
// Portada: tu nombre y la mesa de dibujo con una lámina por proyecto.
import { persona } from '../config';
import { t, rutas, type Lang } from '../i18n';
import type { Proyecto } from '../proyectos';
import MesaProyectos from './MesaProyectos.astro';

interface Props {
  lang: Lang;
  proyectos: Proyecto[];
}
const { lang, proyectos } = Astro.props;
const tx = t(lang);
const [nombre1, ...resto] = persona.nombre.split(' ');
const linea1 = `${nombre1} ${resto[0]}`;
const linea2 = resto.slice(1).join(' ');
const inicio = rutas.inicio(lang);
---

<section class="portada contenedor" id="portada" aria-labelledby="nombre">
  <div class="portada__texto">
    <h1 id="nombre">
      <span>{linea1}</span>
      <span>{linea2}</span>
    </h1>
    <p class="lema">{tx.lema}</p>
    <div class="acciones">
      <a class="boton boton--lleno" href={rutas.proyectos(lang)}>{tx.verProyectos}</a>
      <a class="boton" href={`${inicio}#contacto`}>{tx.escribeme}</a>
    </div>
  </div>

  <div class="portada__mesa">
    <MesaProyectos lang={lang} proyectos={proyectos} />
  </div>
</section>

<style>
  .portada {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);
    min-height: calc(100svh - 3.5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .portada {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(2.5rem, 5vw, 5rem); /* separación fija entre el nombre y la mesa */
    }
    .portada__texto {
      position: relative;
      z-index: 1;
      align-self: end;
      padding-bottom: 5rem;
    }
  }

  /* El nombre se escala con el ancho de su propia columna: «Sarmentero» nunca
     se sale de ella, sea cual sea la pantalla o el zoom del navegador */
  .portada__texto {
    container-type: inline-size;
  }
  h1 {
    font-size: clamp(2.4rem, 16cqi, 6.5rem);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    color: var(--azul);
    font-weight: 300;
  }
  .lema {
    font-size: var(--t-3);
    font-stretch: 100%;
    line-height: 1.3;
    margin: 1.75rem 0 2rem;
    max-width: 22ch;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* La mesa va por encima del texto: si arrastras una lámina sobre el nombre,
     la lámina lo tapa como una hoja de papel encima de otra */
  .portada__mesa {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  /* Entrada al cargar: el nombre sube línea a línea, el apellido se ensancha
     (Archivo es de anchura variable) y luego llegan el lema y los botones */
  @media (prefers-reduced-motion: no-preference) {
    h1 span {
      animation: linea 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s backwards;
    }
    h1 span + span {
      animation:
        linea 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s backwards,
        ensanchar 1.4s cubic-bezier(0.3, 0.8, 0.2, 1) 0.3s backwards;
    }
    .lema {
      animation: subir 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.75s backwards;
    }
    .acciones {
      animation: subir 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.9s backwards;
    }
  }
  @keyframes linea {
    from {
      translate: 0 0.6em;
      clip-path: inset(-0.3em -0.2em 100% -0.2em);
    }
    to {
      translate: 0 0;
      clip-path: inset(-0.3em -0.2em -0.3em -0.2em);
    }
  }
  @keyframes ensanchar {
    from {
      font-stretch: 62%;
      letter-spacing: 0.02em;
    }
  }
</style>
