---
// Portada: tu nombre y la pieza destacada dibujada como un plano vivo
// (aristas, aristas ocultas y cotas reales). La pieza es el modelo 3D
// del primer proyecto que tenga uno.
import { persona } from '../config';
import { t, rutas, type Lang } from '../i18n';
import type { Proyecto } from '../proyectos';
import PiezaPlano from './PiezaPlano.astro';

interface Props {
  lang: Lang;
  destacado?: Proyecto;
}
const { lang, destacado } = Astro.props;
const tx = t(lang);
const [nombre1, ...resto] = persona.nombre.split(' ');
const linea1 = `${nombre1} ${resto[0]}`;
const linea2 = resto.slice(1).join(' ');
const inicio = rutas.inicio(lang);
---

<section class="portada contenedor" aria-labelledby="nombre">
  <div class="portada__texto">
    <h1 id="nombre">
      <span>{linea1}</span>
      <span>{linea2}</span>
    </h1>
    <p class="lema">{tx.lema}</p>
    <div class="acciones">
      <a class="boton boton--lleno" href={rutas.proyectos(lang)}>{tx.verProyectos}</a>
      <a class="boton" href={`${inicio}#contacto`}>{tx.escribeme}</a>
    </div>
  </div>

  {destacado?.data.modelo && (
    <figure class="portada__pieza">
      <PiezaPlano src={destacado.data.modelo} lang={lang} etiqueta={destacado.data.portadaAlt} />
      <figcaption>
        <table class="cajetin pie-pieza">
          <tbody>
            <tr>
              <th scope="row">{tx.piezaDestacada}</th>
              <td>
                <a href={rutas.proyecto(lang, destacado.slug)}>{destacado.data.titulo}</a>
              </td>
              <td class="pie-pieza__anio">{destacado.data.anio}</td>
            </tr>
            <tr>
              <th scope="row">{tx.cotasMm}</th>
              <td colspan="2" class="pie-pieza__ver">
                <a href={rutas.proyecto(lang, destacado.slug)}>{tx.verProyecto}</a>
              </td>
            </tr>
          </tbody>
        </table>
      </figcaption>
    </figure>
  )}
</section>

<style>
  .portada {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);
    min-height: calc(100svh - 3.5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .portada {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
    }
    .portada__texto {
      position: relative;
      z-index: 1;
      align-self: end;
      padding-bottom: 5rem;
    }
  }

  h1 {
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    color: var(--azul);
    font-weight: 300;
  }
  .lema {
    font-size: var(--t-3);
    font-stretch: 100%;
    line-height: 1.3;
    margin: 1.75rem 0 2rem;
    max-width: 22ch;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .portada__pieza {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 60rem) {
    .portada__pieza {
      margin-left: 1rem;
    }
  }
  .pie-pieza {
    justify-self: end;
    width: min(100%, 26rem);
  }
  .pie-pieza td {
    font-size: var(--t-0);
  }
  .pie-pieza td a {
    color: var(--tinta);
    text-decoration: none;
  }
  .pie-pieza td a:hover {
    color: var(--azul);
    text-decoration: underline;
  }
  .pie-pieza__anio {
    width: 1%;
    font-variant-numeric: tabular-nums;
  }
  .pie-pieza__ver a {
    color: var(--azul) !important;
  }
</style>
