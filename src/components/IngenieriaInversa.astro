---
// Sección «Ingeniería inversa»: proyectos pequeños (piezas medidas, rediseñadas
// y fabricadas), con tarjetas más pequeñas que las de los proyectos grandes.
// Sale en la portada (entre «Cómo trabajo» y «Sobre mí») y al final de la pestaña Proyectos.
import TarjetaProyecto from './TarjetaProyecto.astro';
import { proyectosDeGrupo } from '../proyectos';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: clase } = Astro.props;
const tx = t(lang);
const piezas = await proyectosDeGrupo(lang, 'ingenieria-inversa');
---

{piezas.length > 0 && (
  <section class:list={['inversa', clase]} id="ingenieria-inversa" aria-labelledby="inversa-t">
    <div class="contenedor">
      <h2 id="inversa-t" class="titulo-seccion" data-aparecer>{tx.inversaTitulo}</h2>
      <p class="entradilla" data-aparecer style="--retraso:0.1s">{tx.inversaIntro}</p>
      <div class="piezas">
        {piezas.map((p, i) => <TarjetaProyecto proyecto={p} indice={i} compacta />)}
      </div>
    </div>
  </section>
)}

<style>
  .inversa {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) 0;
    scroll-margin-top: 4rem;
  }
  /* en la portada va entre «Cómo trabajo» y «Sobre mí»: sigue la banda clara sin cortes */
  .inversa--banda {
    background: var(--banda);
  }
  .entradilla {
    max-width: 60ch;
  }
  /* tarjetas de unos 16 rem: caben tres o cuatro donde van dos proyectos grandes */
  .piezas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }
</style>
