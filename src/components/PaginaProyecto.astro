---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Visor3D from './Visor3D.astro';
import PiezaPlano from './PiezaPlano.astro';
import IndiceLateral from './IndiceLateral.astro';
import type { Proyecto } from '../proyectos';
import { persona } from '../config';
import { t, rutas, type Lang } from '../i18n';

interface Props {
  proyecto: Proyecto;
  lang: Lang;
  siguiente?: Proyecto;
}
const { proyecto, lang, siguiente } = Astro.props;
const { data } = proyecto;
const tx = t(lang);
const otro: Lang = lang === 'es' ? 'en' : 'es';
const { Content, headings } = await render(proyecto);
// Índice lateral: las fases del caso de estudio (los títulos ##)
const fases = headings.filter((h) => h.depth === 2);
---

<Base
  lang={lang}
  titulo={data.titulo}
  descripcion={data.resumen}
  alternativa={rutas.proyecto(otro, proyecto.slug)}
  imagen={data.portada.src}
>
  <article class="proyecto">
    <header class:list={['contenedor', 'cabeza', { 'cabeza--plano': data.modelo }]}>
      <div class="cabeza__texto">
      <a class="volver" href={rutas.proyectos(lang)}>
        <!-- flecha como una línea de cota: punta rellena y trazo que se alarga al pasar el ratón -->
        <span class="volver__cota" aria-hidden="true"></span>
        <span class="volver__texto">{tx.volver}</span>
      </a>
      <h1 data-aparecer>{data.titulo}</h1>
      <p class="entradilla" data-aparecer style="--retraso:0.1s">{data.resumen}</p>
      <table class="cajetin datos" data-aparecer style="--retraso:0.2s">
        <tbody>
          <tr><th scope="row">{tx.anio}</th><td>{data.anio}</td></tr>
          {data.contexto && <tr><th scope="row">{tx.contexto}</th><td>{data.contexto}</td></tr>}
          {data.equipo.length > 0 && (
            <tr><th scope="row">{tx.equipo}</th><td>{persona.nombre}, {data.equipo.join(', ')}</td></tr>
          )}
          {data.rol && <tr><th scope="row">{tx.rol}</th><td>{data.rol}</td></tr>}
          {data.herramientas.length > 0 && (
            <tr><th scope="row">{tx.herramientas}</th><td>{data.herramientas.join(', ')}</td></tr>
          )}
        </tbody>
      </table>
      </div>
      {data.modelo && <PiezaPlano src={data.modelo} lang={lang} etiqueta={data.portadaAlt} class="cabeza__plano" />}
    </header>

    <div class="contenedor medios" data-aparecer style="--retraso:0.3s">
      {data.modelo ? (
        <Visor3D src={data.modelo} alt={data.modeloAlt ?? data.portadaAlt} lang={lang} variantes={data.modeloVariantes} etiquetaVariantes={data.etiquetaVariantes} acabados={data.acabados} etiquetaAcabados={data.etiquetaAcabados} interruptorLuz={data.interruptorLuz} />
      ) : (
        <Image src={data.portada} alt={data.portadaAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="portada" />
      )}
    </div>

    <div class:list={['contenedor', 'lectura', { 'lectura--indice': fases.length > 1 }]}>
      {fases.length > 1 && (
        <IndiceLateral
          lang={lang}
          titulo={data.titulo}
          etiqueta={tx.indice}
          entradas={fases.map((f) => ({ id: f.slug, texto: f.text }))}
        />
      )}
      <div class="cuerpo" data-aparecer-hijos>
        <Content />
      </div>
    </div>

    {siguiente && (
      <nav class="contenedor siguiente" aria-label={tx.siguiente}>
        <span class="nota">{tx.siguiente}</span>
        <a href={rutas.proyecto(lang, siguiente.slug)}>{siguiente.data.titulo}</a>
      </nav>
    )}
  </article>
</Base>


<style>
  .cabeza {
    padding-block: clamp(2rem, 6vw, 4rem) 2rem;
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 60rem) {
    .cabeza--plano {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  .cabeza :global(.cabeza__plano) {
    max-width: 30rem;
    justify-self: center;
  }
  /* «Volver a proyectos»: rótulo pequeño, como el del índice, con una flecha de cota */
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    padding-block: 0.35rem;
    color: var(--tinta-suave);
    text-decoration: none;
    font-size: var(--t-0);
    font-weight: 600;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }
  .volver__cota {
    position: relative;
    width: 1.75rem;
    height: 1px;
    background: var(--azul);
    transition: width 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .volver__cota::before {
    /* punta de flecha */
    content: '';
    position: absolute;
    left: -1px;
    top: -4px;
    border-style: solid;
    border-width: 4.5px 9px 4.5px 0;
    border-color: transparent var(--azul) transparent transparent;
  }
  .volver__cota::after {
    /* línea de referencia al final, como en una cota */
    content: '';
    position: absolute;
    right: 0;
    top: -5px;
    width: 1px;
    height: 11px;
    background: var(--azul);
  }
  .volver:hover {
    color: var(--tinta);
  }
  .volver:hover .volver__cota {
    width: 2.75rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
    max-width: 18ch;
  }
  .entradilla {
    margin-bottom: 0.5rem;
  }
  .datos {
    width: min(100%, 36rem);
  }
  .medios {
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }
  .medios :global(.portada) {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  /* Lectura: índice fijo a la izquierda (en pantallas anchas) y el caso de estudio a
     la derecha, alineado con la cabecera. El texto, a unas 70 letras por línea; las
     imágenes, tablas y visores, a todo el ancho de su columna. */
  .lectura {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  @media (min-width: 60rem) {
    .lectura--indice {
      display: grid;
      grid-template-columns: 12.5rem minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
  }
  /* Cuerpo del caso de estudio: cada ## es una fase numerada */
  .cuerpo {
    counter-reset: fase;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  /* sin índice (o en el móvil), la columna de texto se queda a la izquierda, alineada con lo de arriba */
  .lectura:not(.lectura--indice) .cuerpo {
    max-width: 52rem;
  }
  .cuerpo :global(p),
  .cuerpo :global(ul),
  .cuerpo :global(ol),
  .cuerpo :global(blockquote) {
    max-width: 68ch;
  }
  .cuerpo :global(p:has(> img)) {
    max-width: none;
  }
  .cuerpo :global(h2) {
    counter-increment: fase;
    scroll-margin-top: 5rem;
    font-size: var(--t-4);
    margin: 3.5rem 0 1rem;
    padding-top: 1rem;
    border-top: var(--trazo-grueso) solid var(--tinta);
    display: flex;
    gap: 0.6em;
    align-items: baseline;
  }
  .cuerpo :global(h2)::before {
    content: counter(fase);
    color: var(--azul);
    font-weight: 300;
  }
  .cuerpo :global(h3) {
    font-size: var(--t-3);
    margin: 2rem 0 0.75rem;
  }
  .cuerpo :global(p),
  .cuerpo :global(li) {
    font-size: var(--t-2);
    line-height: 1.6;
  }
  /* Las imágenes van recortadas, sin fondo, directamente sobre el papel */
  .cuerpo :global(img) {
    width: 100%;
    margin-block: 1.5rem 0.5rem;
  }
  /* En modo oscuro, los dibujos con líneas negras necesitan un papel claro detrás */
  /* Dibujos con líneas o textos negros (archivos que terminan en «-dibujo»):
     van sobre una hoja clara para que se lean en el fondo oscuro */
  .cuerpo :global(img[src*='-dibujo']) {
    background: var(--lamina-fondo);
    padding: 0.75rem;
  }
  /* Imagen sola vertical: que no ocupe más que la pantalla */
  .cuerpo :global(p > img:only-of-type:not([src$='.svg'])) {
    max-height: 75vh;
    object-fit: contain;
  }
  /* Varias imágenes seguidas en un párrafo: en fila */
  /* Flex y no grid: con grid, el pie de foto (que ocupa toda la fila) impedía
     que las columnas vacías se plegaran y las imágenes salían diminutas */
  .cuerpo :global(p:has(> img + img)) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: flex-end;
    max-width: none;
  }
  .cuerpo :global(p:has(> img + img) > img) {
    flex: 1 1 12rem;
    width: auto;
    min-width: 0;
    margin-bottom: 0;
  }
  .cuerpo :global(p:has(> img[src$='.svg'] + img) > img) {
    flex-basis: 100%;
  }
  .cuerpo :global(p:has(> img + img) > em) {
    flex-basis: 100%;
  }
  /* Pie de foto: la línea en cursiva justo debajo de la imagen */
  .cuerpo :global(table + p > em:only-child) {
    font-style: normal;
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
  }
  .cuerpo :global(> .boton) {
    margin-top: 0.5rem;
    width: fit-content;
  }
  /* Vídeo dentro del texto (<figure class="video-md">) */
  .cuerpo :global(.video-md) {
    margin: 2rem 0;
  }
  .cuerpo :global(.video-md video) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #1d1c1a;
  }
  .cuerpo :global(.video-md figcaption) {
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }
  /* Visor 3D dentro del texto (<figure class="visor-md">) */
  .cuerpo :global(.visor-md) {
    margin: 2rem 0;
  }
  .cuerpo :global(.visor-md model-viewer) {
    display: block;
    position: relative;
    width: 100%;
    height: clamp(22rem, 70vh, 44rem);
    border: var(--trazo-grueso) solid var(--lamina-fondo);
    background: var(--lamina-fondo);
  }
  .cuerpo :global(.visor-md figcaption) {
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }
  .cuerpo :global(p:has(> img) > em) {
    display: block;
    font-style: normal;
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
    text-align: left;
  }
  /* Planos vectoriales de CATIA: sin fondo, y en modo oscuro en blanco */
  .cuerpo :global(img[src$='.svg']) {
    background: transparent;
    border: 0;
    padding: 0.5rem 0;
  }
  .cuerpo :global(img[src$='.svg']) {
    filter: invert(1);
  }
  /* Tablas (presupuestos, medidas) con aspecto de cajetín */
  .cuerpo :global(table) {
    border-collapse: collapse;
    border: var(--trazo-grueso) solid var(--tinta);
    margin: 1.5rem 0;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }
  .cuerpo :global(th),
  .cuerpo :global(td) {
    border: var(--trazo) solid var(--tinta);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .cuerpo :global(th) {
    font-weight: 500;
    font-stretch: 80%;
    color: var(--tinta-suave);
    font-size: var(--t-0);
  }
  .cuerpo :global(td:last-child) {
    text-align: right;
    font-weight: 600;
  }
  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    padding-left: 1.25em;
    margin: 0 0 1em;
  }
  .cuerpo :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: var(--trazo-grueso) solid var(--revision);
    font-size: var(--t-3);
    font-weight: 500;
  }

  .siguiente {
    border-top: var(--trazo) solid var(--linea);
    padding-block: 2.5rem 3.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .siguiente a {
    font-size: var(--t-4);
    font-weight: 750;
    font-stretch: 118%;
    line-height: 1.1;
    width: fit-content;
  }
</style>
