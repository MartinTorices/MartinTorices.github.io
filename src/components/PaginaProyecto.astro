---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Visor3D from './Visor3D.astro';
import PiezaPlano from './PiezaPlano.astro';
import Icono from './Icono.astro';
import type { Proyecto } from '../proyectos';
import { persona } from '../config';
import { t, rutas, type Lang } from '../i18n';

interface Props {
  proyecto: Proyecto;
  lang: Lang;
  siguiente?: Proyecto;
}
const { proyecto, lang, siguiente } = Astro.props;
const { data } = proyecto;
const tx = t(lang);
const otro: Lang = lang === 'es' ? 'en' : 'es';
const { Content } = await render(proyecto);
---

<Base
  lang={lang}
  titulo={data.titulo}
  descripcion={data.resumen}
  alternativa={rutas.proyecto(otro, proyecto.slug)}
  imagen={data.portada.src}
>
  <article class="proyecto">
    <header class:list={['contenedor', 'cabeza', { 'cabeza--plano': data.modelo }]}>
      <div class="cabeza__texto">
      <a class="volver" href={rutas.proyectos(lang)}><Icono nombre="flecha-izq" />{tx.volver}</a>
      <h1>{data.titulo}</h1>
      <p class="entradilla">{data.resumen}</p>
      <table class="cajetin datos">
        <tbody>
          <tr><th scope="row">{tx.anio}</th><td>{data.anio}</td></tr>
          {data.contexto && <tr><th scope="row">{tx.contexto}</th><td>{data.contexto}</td></tr>}
          {data.equipo.length > 0 && (
            <tr><th scope="row">{tx.equipo}</th><td>{persona.nombre}, {data.equipo.join(', ')}</td></tr>
          )}
          {data.rol && <tr><th scope="row">{tx.rol}</th><td>{data.rol}</td></tr>}
          {data.herramientas.length > 0 && (
            <tr><th scope="row">{tx.herramientas}</th><td>{data.herramientas.join(', ')}</td></tr>
          )}
        </tbody>
      </table>
      </div>
      {data.modelo && <PiezaPlano src={data.modelo} lang={lang} etiqueta={data.portadaAlt} class="cabeza__plano" />}
    </header>

    <div class="contenedor medios">
      {data.modelo ? (
        <Visor3D src={data.modelo} alt={data.portadaAlt} lang={lang} variantes={data.modeloVariantes} etiquetaVariantes={data.etiquetaVariantes} />
      ) : (
        <Image src={data.portada} alt={data.portadaAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="portada" />
      )}
    </div>

    <div class="contenedor cuerpo">
      <Content />
    </div>

    {siguiente && (
      <nav class="contenedor siguiente" aria-label={tx.siguiente}>
        <span class="nota">{tx.siguiente}</span>
        <a href={rutas.proyecto(lang, siguiente.slug)}>{siguiente.data.titulo}</a>
      </nav>
    )}
  </article>
</Base>

<style>
  .cabeza {
    padding-block: clamp(2rem, 6vw, 4rem) 2rem;
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 60rem) {
    .cabeza--plano {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  .cabeza :global(.cabeza__plano) {
    max-width: 30rem;
    justify-self: center;
  }
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
    font-stretch: 92%;
  }
  .volver :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
    max-width: 18ch;
  }
  .entradilla {
    margin-bottom: 0.5rem;
  }
  .datos {
    width: min(100%, 36rem);
  }
  .medios {
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }
  .medios :global(.portada) {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  /* Cuerpo del caso de estudio: cada ## es una fase numerada */
  .cuerpo {
    counter-reset: fase;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: calc(46rem + 2 * var(--gutter));
    margin-inline: auto;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .cuerpo :global(h2) {
    counter-increment: fase;
    font-size: var(--t-4);
    margin: 3.5rem 0 1rem;
    padding-top: 1rem;
    border-top: var(--trazo-grueso) solid var(--tinta);
    display: flex;
    gap: 0.6em;
    align-items: baseline;
  }
  .cuerpo :global(h2)::before {
    content: counter(fase);
    color: var(--azul);
    font-weight: 300;
  }
  .cuerpo :global(h3) {
    font-size: var(--t-3);
    margin: 2rem 0 0.75rem;
  }
  .cuerpo :global(p),
  .cuerpo :global(li) {
    font-size: var(--t-2);
    line-height: 1.6;
  }
  /* Las imágenes van recortadas, sin fondo, directamente sobre el papel */
  .cuerpo :global(img) {
    width: 100%;
    margin-block: 1.5rem 0.5rem;
  }
  /* En modo oscuro, los dibujos con líneas negras necesitan un papel claro detrás */
  @media (prefers-color-scheme: dark) {
    .cuerpo :global(img:not([src$='.svg'])) {
      background: #eef1f0;
      padding: 0.75rem;
    }
  }
  /* Imagen sola vertical: que no ocupe más que la pantalla */
  .cuerpo :global(p > img:only-of-type:not([src$='.svg'])) {
    max-height: 75vh;
    object-fit: contain;
  }
  /* Varias imágenes seguidas en un párrafo: en fila */
  .cuerpo :global(p:has(> img + img)) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0 1rem;
    align-items: end;
    max-width: none;
  }
  .cuerpo :global(p:has(> img[src$='.svg'] + img)) {
    grid-template-columns: 1fr;
  }
  .cuerpo :global(p:has(> img + img) > img) {
    margin-bottom: 0;
  }
  .cuerpo :global(p:has(> img + img) > em) {
    grid-column: 1 / -1;
  }
  /* Pie de foto: la línea en cursiva justo debajo de la imagen */
  .cuerpo :global(table + p > em:only-child) {
    font-style: normal;
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
  }
  .cuerpo :global(> .boton) {
    margin-top: 0.5rem;
    width: fit-content;
  }
  /* Visor 3D dentro del texto (<figure class="visor-md">) */
  .cuerpo :global(.visor-md) {
    margin: 2rem 0;
  }
  .cuerpo :global(.visor-md model-viewer) {
    display: block;
    width: 100%;
    height: clamp(22rem, 70vh, 44rem);
    border: var(--trazo-grueso) solid var(--tinta);
    background: var(--papel-2);
  }
  .cuerpo :global(.visor-md figcaption) {
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }
  .cuerpo :global(p:has(> img) > em) {
    display: block;
    font-style: normal;
    font-size: var(--t-0);
    font-stretch: 85%;
    color: var(--tinta-suave);
    margin-top: 0.5rem;
    text-align: left;
  }
  /* Planos vectoriales de CATIA: sin fondo, y en modo oscuro en blanco */
  .cuerpo :global(img[src$='.svg']) {
    background: transparent;
    border: 0;
    padding: 0.5rem 0;
  }
  @media (prefers-color-scheme: dark) {
    .cuerpo :global(img[src$='.svg']) {
      filter: invert(1);
    }
  }
  /* Tablas (presupuestos, medidas) con aspecto de cajetín */
  .cuerpo :global(table) {
    border-collapse: collapse;
    border: var(--trazo-grueso) solid var(--tinta);
    margin: 1.5rem 0;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }
  .cuerpo :global(th),
  .cuerpo :global(td) {
    border: var(--trazo) solid var(--tinta);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .cuerpo :global(th) {
    font-weight: 500;
    font-stretch: 80%;
    color: var(--tinta-suave);
    font-size: var(--t-0);
  }
  .cuerpo :global(td:last-child) {
    text-align: right;
    font-weight: 600;
  }
  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    padding-left: 1.25em;
    margin: 0 0 1em;
  }
  .cuerpo :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: var(--trazo-grueso) solid var(--revision);
    font-size: var(--t-3);
    font-weight: 500;
  }

  .siguiente {
    border-top: var(--trazo) solid var(--linea);
    padding-block: 2.5rem 3.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .siguiente a {
    font-size: var(--t-4);
    font-weight: 750;
    font-stretch: 118%;
    line-height: 1.1;
    width: fit-content;
  }
</style>
