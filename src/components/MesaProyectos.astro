---
// Portada: la «mesa de dibujo». Una lámina por proyecto (su portada),
// repartidas y solapadas sobre la mesa. Se pueden arrastrar con el ratón
// y al hacer clic se abre el proyecto. Se reparten solas según cuántos haya.
import { Image } from 'astro:assets';
import type { Proyecto } from '../proyectos';
import { t, rutas, type Lang } from '../i18n';
import { escuadra, cartabon, escalimetro, portaminas } from '../utiles-dibujo';

interface Props {
  lang: Lang;
  proyectos: Proyecto[];
}
const { lang, proyectos } = Astro.props;
const tx = t(lang);

// Posiciones sobre la mesa en % (x, y, ancho, giro en grados) según el número de láminas
type Hueco = [number, number, number, number];
const disposiciones: Record<number, Hueco[]> = {
  1: [[10, 10, 78, -2.5]],
  2: [[2, 6, 58, -5], [38, 34, 58, 4]],
  3: [[0, 4, 54, -6], [46, 2, 52, 5], [22, 40, 52, -2]],
  4: [[0, 2, 50, -6], [50, 0, 48, 4], [4, 50, 46, 3], [48, 44, 50, -4]],
};
const general: Hueco[] = [
  [0, 3, 37, -5], [31, 0, 36, 3], [63, 5, 36, -3], [5, 36, 36, 4],
  [36, 31, 38, -2], [66, 39, 34, 5], [14, 62, 36, -4], [50, 63, 36, 3],
];
const lista = proyectos.slice(0, 12);
const huecos = disposiciones[lista.length] ?? lista.map((_, i) => general[i % general.length]);
// La primera lámina (proyecto con menor «orden») queda encima
const capas = lista.map((p, i) => ({ p, h: huecos[i], z: lista.length - i })).reverse();
// Para el reparto inicial: cuánto hay que mover cada lámina (en % de su propio
// tamaño) para que salga del centro de la mesa, como un mazo de cartas.
// Alto de la lámina ≈ 0,86 × su ancho; la mesa es 6:5.
const mazo = (h: Hueco) => {
  const alto = (h[2] * 0.86 * 6) / 5; // alto de la lámina en % del alto de la mesa
  const ox = ((50 - (h[0] + h[2] / 2)) / h[2]) * 100;
  const oy = ((58 - (h[1] + alto / 2)) / alto) * 100;
  return `--ox:${ox.toFixed(1)}%;--oy:${oy.toFixed(1)}%`;
};

// Útiles de dibujo sobre la mesa (x, y, ancho en % de la mesa; giro; svg). Van
// encima de las láminas, se pueden arrastrar igual y no abren nada.
const utiles: { nombre: string; x: number; y: number; w: number; r: number; svg: string }[] = [
  { nombre: 'escuadra', x: -9, y: 36, w: 32, r: 7, svg: escuadra },
  { nombre: 'cartabon', x: 64, y: -9, w: 38, r: -14, svg: cartabon },
  { nombre: 'escalimetro', x: 46, y: 99, w: 52, r: -3, svg: escalimetro },
  { nombre: 'portaminas', x: 14, y: 99, w: 33, r: 9, svg: portaminas },
];
---

{lista.length > 0 && (
  <figure class="mesa" data-mesa>
    <div class="mesa__tablero">
      {capas.map(({ p, h, z }, i) => (
        <a
          class="lamina"
          href={rutas.proyecto(lang, p.slug)}
          style={`--x:${h[0]}%;--y:${h[1]}%;--w:${h[2]}%;--r:${h[3]}deg;--z:${z};--i:${capas.length - 1 - i};${mazo(h)}`}
          draggable="false"
        >
          <span class="lamina__imagen">
            <Image src={p.data.portada} alt="" widths={[360, 640, 960]} sizes="(max-width: 60rem) 70vw, 32vw" loading="eager" draggable="false" />
          </span>
          <span class="lamina__rotulo">
            <span class="lamina__titulo">{p.data.titulo}</span>
            <span class="lamina__anio">{p.data.anio}</span>
          </span>
        </a>
      ))}
      {utiles.map((u, k) => (
        <div
          class={`util util--${u.nombre}`}
          style={`--x:${u.x}%;--y:${u.y}%;--w:${u.w}%;--r:${u.r}deg;--z:${20 + k};--i:${capas.length + k}`}
          aria-hidden="true"
          set:html={u.svg}
        />
      ))}
    </div>
    <figcaption class="nota mesa__ayuda">
      <span class="ayuda-raton">{tx.mesaAyuda}</span>
      <span class="ayuda-tactil">{tx.mesaAyudaTactil}</span>
    </figcaption>
  </figure>
)}

<script>
  // Arrastrar láminas con el ratón; un clic sin arrastrar abre el proyecto.
  // Todo (posición, velocidad, inclinación y rebotes) se calcula en un único
  // bucle por fotograma: los eventos del ratón solo guardan dónde está el
  // puntero. Así el movimiento no vibra aunque el ratón mande datos irregulares.
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MARGEN = 12; // px libres entre la lámina y el borde de la pantalla
  const REBOTE = 0.55; // velocidad que conserva al chocar con un borde
  const lim = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  document.querySelectorAll<HTMLElement>('[data-mesa]').forEach((mesa) => {
    let arriba = 100;
    const tablero = mesa.querySelector<HTMLElement>('.mesa__tablero')!;
    const pie = document.querySelector<HTMLElement>('footer');

    mesa.querySelectorAll<HTMLElement>('.lamina, .util').forEach((lam) => {
      let x = 0, y = 0; // desplazamiento actual
      let px = 0, py = 0; // desplazamiento que pide el puntero
      let cx = 0, cy = 0; // puntero en la pantalla
      let ox = 0, oy = 0; // dónde se cogió la lámina
      let vx = 0, vy = 0; // velocidad (px/ms) para la inercia
      let sx = 0; // velocidad horizontal muy suavizada, solo para inclinarla
      let giro = 0;
      // los útiles conservan su giro al cogerlos; las láminas se enderezan
      const base = lam.classList.contains('util') ? parseFloat(getComputedStyle(lam).getPropertyValue('--r')) || 0 : 0;
      let activo = false, movido = false, bucle = 0, antes = 0, ultimoMovimiento = 0;

      // Hasta dónde puede ir la lámina: a los lados, el ancho de la pantalla (ahí
      // rebota); hacia arriba y hacia abajo, toda la página (se puede llevar hasta
      // «Sobre mí» o «Contacto»). Se mide con la caja sin girar, para que el giro
      // no haga temblar el límite.
      const limites = () => {
        const t = tablero.getBoundingClientRect();
        const finPagina = pie ? pie.getBoundingClientRect().top : document.documentElement.scrollHeight - window.scrollY;
        const izq = t.left + lam.offsetLeft;
        const arr = t.top + lam.offsetTop;
        const ancho = document.documentElement.clientWidth;
        const w = lam.offsetWidth, h = lam.offsetHeight;
        // holgura fija para lo que crece al levantarla (escala) y al inclinarla (hasta ~10°)
        const mx = MARGEN + w * 0.05 + h * 0.09;
        const my = MARGEN + h * 0.05 + w * 0.09;
        return {
          minX: mx - izq,
          maxX: ancho - mx - (izq + w),
          minY: -window.scrollY + my - arr,
          maxY: finPagina - my - (arr + h),
        };
      };
      // Al empujar contra un borde, la lámina cede un poco (como una goma), 18 px como mucho
      const ceder = (d: number) => 18 * (1 - Math.exp(-d / 90));
      const goma = (v: number, a: number, b: number) =>
        v < a ? a - ceder(a - v) : v > b ? b + ceder(v - b) : v;

      const pintar = () => {
        lam.style.setProperty('--dx', `${x.toFixed(2)}px`);
        lam.style.setProperty('--dy', `${y.toFixed(2)}px`);
        lam.style.setProperty('--giro', `${giro.toFixed(2)}deg`);
      };

      const fotograma = (ahora: number) => {
        const dt = lim(ahora - antes, 1, 34);
        antes = ahora;
        const L = limites();

        if (activo) {
          // Cerca del borde de arriba o de abajo de la pantalla, la página se desplaza
          // sola para poder llevar la lámina más abajo (o más arriba)
          const zona = 80;
          const abajo = cy - (window.innerHeight - zona);
          const arriba = zona + 56 - cy; // 56 px: la cabecera fija
          if (abajo > 0) window.scrollBy({ top: Math.min(1, abajo / zona) * 0.9 * dt, behavior: 'instant' });
          else if (arriba > 0 && window.scrollY > 0)
            window.scrollBy({ top: -Math.min(1, arriba / zona) * 0.9 * dt, behavior: 'instant' });
          // la posición se cuenta sobre la página: si se desplaza, la lámina sigue al puntero
          px = cx - ox;
          py = cy + window.scrollY - oy;
          // Sigue al puntero (con resistencia si se sale) y mide la velocidad por fotograma
          const nx = goma(px, L.minX, L.maxX);
          const ny = goma(py, L.minY, L.maxY);
          vx += ((nx - x) / dt - vx) * 0.35;
          vy += ((ny - y) / dt - vy) * 0.35;
          x = nx;
          y = ny;
        } else {
          // Inercia: sigue avanzando, frena poco a poco y rebota en los bordes
          x += vx * dt;
          y += vy * dt;
          const roce = Math.pow(0.993, dt);
          vx *= roce;
          vy *= roce;
          if (x < L.minX && vx < 0) vx = -vx * REBOTE;
          if (x > L.maxX && vx > 0) vx = -vx * REBOTE;
          if (y < L.minY && vy < 0) vy = -vy * REBOTE;
          if (y > L.maxY && vy > 0) vy = -vy * REBOTE;
          // si ha quedado fuera, un muelle la devuelve dentro
          const fx = x < L.minX ? L.minX - x : x > L.maxX ? L.maxX - x : 0;
          const fy = y < L.minY ? L.minY - y : y > L.maxY ? L.maxY - y : 0;
          vx += fx * 0.0012 * dt;
          vy += fy * 0.0012 * dt;
          if (fx) vx *= Math.pow(0.975, dt);
          if (fy) vy *= Math.pow(0.975, dt);
        }

        // Inclinación: se basa en una velocidad muy suavizada y se acerca poco a poco
        sx += (vx - sx) * (activo ? 0.08 : 0.2);
        const objetivo = base + (activo ? lim(sx * 7, -9, 9) : 0);
        giro += (objetivo - giro) * Math.min(1, dt * 0.012);
        pintar();

        const quieta =
          !activo &&
          Math.hypot(vx, vy) < 0.015 &&
          x >= L.minX - 0.5 && x <= L.maxX + 0.5 && y >= L.minY - 0.5 && y <= L.maxY + 0.5;
        if (quieta) {
          x = lim(x, L.minX, L.maxX);
          y = lim(y, L.minY, L.maxY);
          giro = base;
          pintar();
          caer();
        } else bucle = requestAnimationFrame(fotograma);
      };

      // Al terminar, un pequeño golpe contra la mesa
      const caer = () => {
        lam.classList.remove('lamina--volando');
        if (reducir) return;
        lam.animate([{ scale: '1.07' }, { scale: '0.985', offset: 0.45 }], {
          duration: 500,
          easing: 'cubic-bezier(0.3, 0.7, 0.4, 1)',
        });
      };

      const subir = () => (lam.style.zIndex = String(++arriba));
      lam.addEventListener('pointerenter', subir);
      lam.addEventListener('focus', subir);

      lam.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        cancelAnimationFrame(bucle);
        lam.classList.remove('lamina--volando');
        activo = true;
        movido = false;
        ox = e.clientX - x;
        oy = e.clientY + window.scrollY - y;
        cx = e.clientX;
        cy = e.clientY;
        px = x;
        py = y;
        vx = vy = 0;
        subir();
        lam.setPointerCapture(e.pointerId);
      });
      lam.addEventListener('pointermove', (e) => {
        if (!activo) return;
        cx = e.clientX;
        cy = e.clientY;
        px = cx - ox;
        py = cy + window.scrollY - oy;
        ultimoMovimiento = e.timeStamp;
        if (!movido && Math.hypot(px - x, py - y) >= 4) {
          movido = true;
          // empieza desde la inclinación que tenga ahora (sin saltos)
          giro = parseFloat(getComputedStyle(lam).rotate) || 0;
          sx = 0;
          lam.classList.add('lamina--arrastrando');
          antes = performance.now();
          bucle = requestAnimationFrame(fotograma);
        }
      });
      const soltar = (e: PointerEvent) => {
        if (!activo) return;
        activo = false;
        lam.classList.remove('lamina--arrastrando');
        if (!movido) return;
        mesa.classList.add('mesa--tocada');
        // si el ratón llevaba un rato quieto al soltar, no hay inercia
        if (e.timeStamp - ultimoMovimiento > 80) vx = vy = 0;
        const v = Math.hypot(vx, vy);
        if (v > 3) {
          vx *= 3 / v;
          vy *= 3 / v;
        }
        if (reducir) {
          vx = vy = 0;
        }
        lam.classList.add('lamina--volando');
        // el bucle sigue: ahora con inercia y rebotes hasta que se pare
      };
      lam.addEventListener('pointerup', soltar);
      lam.addEventListener('pointercancel', soltar);
      lam.addEventListener('lostpointercapture', soltar as EventListener);
      lam.addEventListener('click', (e) => {
        if (movido) {
          e.preventDefault();
          movido = false;
        }
      });
    });
  });
</script>

<style>
  .mesa {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .mesa__tablero {
    position: relative;
    aspect-ratio: 6 / 5;
    width: 100%;
  }
  .lamina {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    z-index: var(--z);
    display: block;
    color: var(--lamina-tinta);
    text-decoration: none;
    background: var(--lamina-fondo);
    border: var(--trazo-grueso) solid var(--lamina-fondo);
    box-shadow: 0 1px 0 var(--linea), 0 10px 24px -14px rgba(10, 20, 40, 0.45);
    /* translate (arrastre), rotate y scale van por separado: así cada uno
       tiene su propia transición */
    translate: var(--dx, 0px) var(--dy, 0px);
    rotate: var(--r);
    scale: 1;
    transition:
      rotate 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.35s;
    cursor: pointer;
    container-type: inline-size;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: auto;
    animation: repartir 0.9s cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
    animation-delay: calc(var(--i) * 110ms + 350ms);
  }
  @media (hover: hover) and (pointer: fine) {
    .lamina {
      cursor: grab;
    }
  }
  .lamina:hover,
  .lamina:focus-visible {
    rotate: 0deg;
    scale: 1.04;
    box-shadow: 0 1px 0 var(--linea), 0 22px 40px -18px rgba(10, 20, 40, 0.55);
  }
  .lamina:hover .lamina__rotulo,
  .lamina:focus-visible .lamina__rotulo {
    color: #5f5e5a;
  }
  /* Cogida: se levanta (más grande, sombra más lejana) y se inclina con el movimiento */
  .lamina.lamina--arrastrando {
    rotate: var(--giro, 0deg);
    scale: 1.09;
    box-shadow: 0 1px 0 var(--linea), 0 40px 60px -22px rgba(0, 0, 0, 0.7);
    transition:
      scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s;
    cursor: grabbing;
    will-change: translate, rotate;
  }
  /* Deslizándose tras soltarla: aún en el aire */
  .lamina.lamina--volando {
    will-change: translate, rotate;
    scale: 1.06;
    box-shadow: 0 1px 0 var(--linea), 0 32px 50px -22px rgba(0, 0, 0, 0.65);
  }

  .lamina__imagen {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--trazo) solid var(--lamina-tinta);
    pointer-events: none;
  }
  .lamina__imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--lamina-fondo-2);
  }
  .lamina__rotulo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    font-size: clamp(0.68rem, 4.2cqi, 1.1rem);
    font-weight: 700;
    font-stretch: 100%;
    pointer-events: none;
  }
  .lamina__titulo {
    padding: 0.45em 0.7em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lamina__anio {
    padding: 0.45em 0.7em;
    border-left: var(--trazo) solid var(--lamina-tinta);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* Útiles de dibujo: solo responden donde hay material (el hueco de la escuadra
     deja pasar el clic a la lámina de debajo) */
  .util {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    z-index: var(--z);
    --util-trazo: var(--tinta-suave);
    --util-acrilico: rgba(239, 238, 234, 0.07);
    --util-metal: #6d6b66;
    --util-cuerpo: #3a3936;
    translate: var(--dx, 0px) var(--dy, 0px);
    rotate: var(--r);
    scale: 1;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 6px 6px rgba(0, 0, 0, 0.35));
    transition:
      rotate 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.35s;
    animation: colocar 0.9s cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
    animation-delay: calc(var(--i) * 110ms + 450ms);
  }
  .util :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .util :global(text) {
    font-family: var(--fuente);
    font-stretch: 85%;
  }
  .util :global(.util__forma) {
    pointer-events: visiblePainted;
    cursor: grab;
  }
  .util:hover {
    scale: 1.03;
    filter: drop-shadow(0 12px 12px rgba(0, 0, 0, 0.4));
  }
  .util.lamina--arrastrando {
    rotate: var(--giro, var(--r));
    scale: 1.07;
    filter: drop-shadow(0 26px 22px rgba(0, 0, 0, 0.5));
    transition:
      scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.3s;
    will-change: translate, rotate;
  }
  .util.lamina--arrastrando :global(.util__forma) {
    cursor: grabbing;
  }
  .util.lamina--volando {
    scale: 1.05;
    will-change: translate, rotate;
  }
  /* En pantallas estrechas la mesa ocupa todo el ancho: los útiles, algo más dentro */
  @media (max-width: 60rem) {
    .util--escuadra {
      left: 2%;
    }
    .util--cartabon {
      left: 58%;
    }
  }
  @keyframes colocar {
    from {
      opacity: 0;
      translate: 0 -40px;
      rotate: calc(var(--r) + 25deg);
      scale: 1.15;
    }
  }

  .mesa__ayuda {
    justify-self: end;
    margin: 1.25rem 0 0;
    position: relative;
    z-index: 200;
    transition: opacity 0.4s;
    animation: aparecer-ayuda 0.8s ease 1.6s backwards;
  }
  .ayuda-tactil {
    display: none;
  }
  @media (hover: none) {
    .ayuda-raton {
      display: none;
    }
    .ayuda-tactil {
      display: inline;
    }
  }
  .mesa--tocada .mesa__ayuda {
    opacity: 0;
  }

  /* Al cargar, las láminas salen de un mazo en el centro de la mesa y se
     reparten una tras otra, como cartas */
  @keyframes repartir {
    0% {
      opacity: 0;
      translate: var(--ox) calc(var(--oy) + 30%);
      rotate: 0deg;
      scale: 0.82;
    }
    25% {
      opacity: 1;
      translate: var(--ox) var(--oy);
      rotate: calc(var(--r) * -1.5);
      scale: 0.9;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes aparecer-ayuda {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .util,
    .lamina,
    .mesa__ayuda {
      animation: none;
      transition: none;
    }
  }
</style>
