---
import Base from '../layouts/Base.astro';
import Hoja from './Hoja.astro';
import SobreMi from './SobreMi.astro';
import Proceso from './Proceso.astro';
import Contacto from './Contacto.astro';
import IndiceLateral from './IndiceLateral.astro';
import { proyectosDe } from '../proyectos';
import { rutas, t, type Lang } from '../i18n';
import { persona, sobreMi } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const proyectos = await proyectosDe(lang);
const otro: Lang = lang === 'es' ? 'en' : 'es';
const tx = t(lang);
// Índice lateral: las secciones de la página, en el orden en que aparecen
const secciones = [
  { id: 'portada', texto: tx.navProyectos },
  { id: 'proceso', texto: tx.navProceso },
  { id: 'sobre-mi', texto: tx.navSobreMi },
  { id: 'contacto', texto: tx.navContacto },
];
---

<Base lang={lang} descripcion={sobreMi[lang][1]} alternativa={rutas.inicio(otro)}>
  <Hoja lang={lang} proyectos={proyectos} />

  <!-- Bajo la portada, el índice fijo a la izquierda (como en los proyectos) y las
       secciones a la derecha; los fondos de las secciones siguen a todo el ancho -->
  <div class="inicio-cuerpo">
    <div class="inicio-pista">
      <IndiceLateral lang={lang} titulo={persona.nombreCorto} etiqueta={tx.indiceInicio} entradas={secciones} />
    </div>
    <Proceso lang={lang} />
    <SobreMi lang={lang} />
    <Contacto lang={lang} />
  </div>
</Base>

<style>
  .inicio-cuerpo {
    position: relative;
  }
  .inicio-pista {
    display: none;
  }
  @media (min-width: 60rem) {
    .inicio-cuerpo {
      /* mismo ancho de columna y separación que el índice de los proyectos */
      --hueco: calc(12.5rem + clamp(2rem, 4vw, 4rem));
    }
    /* la pista ocupa toda la altura de las secciones y el índice se queda fijo dentro */
    .inicio-pista {
      display: block;
      position: absolute;
      inset-block: 0;
      left: max(0px, calc((100% - var(--ancho)) / 2));
      width: calc(var(--gutter) + 12.5rem);
      padding-left: var(--gutter);
      padding-block: 0 3rem;
      z-index: 1;
      pointer-events: none;
    }
    .inicio-pista :global(.indice) {
      pointer-events: auto;
      /* el borde de arriba, a la altura de la línea de cota de las fases */
      margin-top: calc(2.5rem + 0.55rem - 1px);
    }
  }
</style>

