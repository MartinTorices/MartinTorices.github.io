---
import Base from '../layouts/Base.astro';
import Hoja from './Hoja.astro';
import SobreMi from './SobreMi.astro';
import Proceso from './Proceso.astro';
import Contacto from './Contacto.astro';
import IndiceLateral from './IndiceLateral.astro';
import IngenieriaInversa from './IngenieriaInversa.astro';
import { proyectosDeGrupo } from '../proyectos';
import { rutas, t, type Lang } from '../i18n';
import { persona, estudios } from '../config';
import foto from '../assets/foto-martin.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
// en la mesa de la portada, solo los proyectos grandes
const proyectos = await proyectosDeGrupo(lang, 'principal');
const hayInversa = (await proyectosDeGrupo(lang, 'ingenieria-inversa')).length > 0;
const otro: Lang = lang === 'es' ? 'en' : 'es';
const tx = t(lang);
// Índice lateral: las secciones de la página, en el orden en que aparecen
const secciones = [
  { id: 'proceso', texto: tx.navProceso },
  ...(hayInversa ? [{ id: 'ingenieria-inversa', texto: tx.inversaTitulo }] : []),
  { id: 'sobre-mi', texto: tx.navSobreMi },
  { id: 'contacto', texto: tx.navContacto },
];

// Datos para Google (solo en la portada en español, que es la raíz del sitio):
// el nombre del sitio («Martín Torices» en vez de «GitHub») y quién eres
const raiz = new URL('/', Astro.site).href;
const datosGoogle = lang === 'es' && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${raiz}#web`,
      name: persona.nombreCorto,
      alternateName: [persona.nombre, 'martintorices.github.io'],
      url: raiz,
      inLanguage: ['es', 'en'],
      author: { '@id': `${raiz}#persona` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${raiz}#perfil`,
      url: raiz,
      name: `${persona.nombre} | ${tx.tituloWeb}`,
      isPartOf: { '@id': `${raiz}#web` },
      mainEntity: { '@id': `${raiz}#persona` },
    },
    {
      '@type': 'Person',
      '@id': `${raiz}#persona`,
      name: persona.nombre,
      alternateName: persona.nombreCorto,
      givenName: 'Martín',
      familyName: 'Torices Sarmentero',
      url: raiz,
      image: new URL(foto.src, Astro.site).href,
      jobTitle: `Estudiante de ${estudios.es.titulacion}`,
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Universidad de Valladolid', url: 'https://www.uva.es/' },
      address: { '@type': 'PostalAddress', addressLocality: 'Valladolid', addressCountry: 'ES' },
      knowsAbout: ['Diseño industrial', 'Diseño de producto', 'Desarrollo de producto', ...persona.programas, ...persona.taller.es],
      sameAs: [persona.linkedin, 'https://github.com/MartinTorices'],
    },
  ],
};
---

<Base lang={lang} descripcion={tx.descripcionWeb} alternativa={rutas.inicio(otro)}>
  {datosGoogle && <script slot="head" type="application/ld+json" set:html={JSON.stringify(datosGoogle)} />}
  <Hoja lang={lang} proyectos={proyectos} />

  <!-- Bajo la portada, el índice fijo a la izquierda (como en los proyectos) y las
       secciones a la derecha; los fondos de las secciones siguen a todo el ancho -->
  <div class="inicio-cuerpo">
    <div class="inicio-pista">
      <IndiceLateral lang={lang} titulo={persona.nombreCorto} etiqueta={tx.indiceInicio} entradas={secciones}>
        <!-- aparte de la lista: lleva a la pestaña Proyectos -->
        <a class="boton indice-proyectos" href={rutas.proyectos(lang)}>
          <span>{tx.verProyectos}</span>
          <span class="indice-proyectos__cota" aria-hidden="true"></span>
        </a>
      </IndiceLateral>
    </div>
    <Proceso lang={lang} />
    <IngenieriaInversa lang={lang} class="inversa--banda" />
    <SobreMi lang={lang} />
    <Contacto lang={lang} />
  </div>
</Base>

<style>
  .inicio-cuerpo {
    position: relative;
  }
  .inicio-pista {
    display: none;
  }
  @media (min-width: 60rem) {
    .inicio-cuerpo {
      /* mismo ancho de columna y separación que el índice de los proyectos */
      --hueco: calc(12.5rem + clamp(2rem, 4vw, 4rem));
    }
    /* la pista ocupa toda la altura de las secciones y el índice se queda fijo dentro */
    .inicio-pista {
      display: block;
      position: absolute;
      inset-block: 0;
      left: max(0px, calc((100% - var(--ancho)) / 2));
      width: calc(var(--gutter) + 12.5rem);
      padding-left: var(--gutter);
      padding-block: 0 3rem;
      z-index: 1;
      pointer-events: none;
    }
    .inicio-pista :global(.indice) {
      pointer-events: auto;
      /* el borde de arriba, a la altura de la línea de cota de las fases */
      margin-top: calc(2.5rem + 0.55rem - 1px);
    }
  }
  /* Botón a la pestaña Proyectos, separado de la lista por una línea fina */
  .indice-proyectos {
    justify-content: space-between;
    width: 100%;
    margin-top: 0.25rem;
    border-color: var(--azul);
    color: var(--azul);
    font-size: var(--t-0);
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .indice-proyectos:hover {
    background: var(--azul);
    border-color: var(--azul);
    color: var(--papel);
  }
  /* flecha de cota hacia la derecha (como la de «Volver a proyectos», al revés) */
  .indice-proyectos__cota {
    position: relative;
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    transition: width 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .indice-proyectos__cota::before {
    content: '';
    position: absolute;
    right: -1px;
    top: -4px;
    border-style: solid;
    border-width: 4.5px 0 4.5px 9px;
    border-color: transparent transparent transparent currentColor;
  }
  .indice-proyectos__cota::after {
    content: '';
    position: absolute;
    left: 0;
    top: -5px;
    width: 1px;
    height: 11px;
    background: currentColor;
  }
  .indice-proyectos:hover .indice-proyectos__cota {
    width: 2.25rem;
  }
</style>

