---
// Tarjeta de proyecto con forma de lámina: imagen enmarcada y
// rótulo debajo (título y año), como el cajetín de un plano.
import { Image } from 'astro:assets';
import type { Proyecto } from '../proyectos';
import { rutas } from '../i18n';

interface Props {
  proyecto: Proyecto;
  prioridad?: boolean;
}
const { proyecto, prioridad = false } = Astro.props;
const { data } = proyecto;
const href = rutas.proyecto(proyecto.lang, proyecto.slug);
---

<article class="tarjeta">
  <a href={href} class="tarjeta__enlace">
    <div class="tarjeta__lamina">
      <div class="tarjeta__imagen">
        <Image
          src={data.portada}
          alt={data.portadaAlt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 48rem) 100vw, 50vw"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      </div>
      <div class="tarjeta__rotulo">
        <h3>{data.titulo}</h3>
        <span class="tarjeta__anio">{data.anio}</span>
      </div>
    </div>
    <p class="tarjeta__resumen">{data.resumen}</p>
  </a>
  <ul class="tarjeta__datos nota">
    {data.contexto && <li>{data.contexto}</li>}
    {data.herramientas.map((h) => <li>{h}</li>)}
    {data.modelo && <li class="con-3d">3D</li>}
  </ul>
</article>

<style>
  .tarjeta {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .tarjeta__enlace {
    color: inherit;
    text-decoration: none;
    display: grid;
    gap: 1rem;
  }
  .tarjeta__lamina {
    border: var(--trazo-grueso) solid var(--tinta);
    background: var(--papel);
  }
  .tarjeta__imagen {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--trazo) solid var(--tinta);
  }
  .tarjeta__imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--papel-2);
    transition: transform 0.5s ease;
  }
  .tarjeta__rotulo {
    display: grid;
    grid-template-columns: 1fr auto;
  }
  h3 {
    font-size: var(--t-3);
    padding: 0.7rem 0.9rem;
  }
  .tarjeta__anio {
    border-left: var(--trazo) solid var(--tinta);
    padding: 0.7rem 0.9rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
  }
  .tarjeta__enlace:hover .tarjeta__lamina,
  .tarjeta__enlace:focus-visible .tarjeta__lamina {
    border-color: var(--azul);
  }
  .tarjeta__enlace:hover h3 {
    color: var(--azul);
  }
  .tarjeta__enlace:hover .tarjeta__imagen :global(img) {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta__imagen :global(img) {
      transition: none;
    }
  }
  .tarjeta__resumen {
    margin: 0;
    color: var(--tinta-suave);
  }
  .tarjeta__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tarjeta__datos li {
    border: var(--trazo) solid var(--linea);
    padding: 0.1rem 0.5rem;
  }
  .tarjeta__datos .con-3d {
    border-color: var(--azul);
    color: var(--azul);
    font-weight: 650;
  }
</style>
