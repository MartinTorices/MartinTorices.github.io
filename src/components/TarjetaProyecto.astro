---
// Tarjeta de proyecto con forma de lámina: imagen enmarcada y
// rótulo debajo (título y año), como el cajetín de un plano.
import { Image } from 'astro:assets';
import type { Ficha } from '../proyectos';

interface Props {
  ficha: Ficha;
  prioridad?: boolean;
  indice?: number; // para que las tarjetas aparezcan una tras otra
  compacta?: boolean; // tarjeta pequeña (sección «Ingeniería inversa»)
}
const { ficha, prioridad = false, indice = 0, compacta = false } = Astro.props;
const { href } = ficha;
---

<article class:list={['tarjeta', { 'tarjeta--compacta': compacta, 'tarjeta--grupo': ficha.grupo }]} data-aparecer style={`--retraso:${(0.15 + (indice % 3) * 0.12).toFixed(2)}s`}>
  <a href={href} class="tarjeta__enlace">
    <div class="tarjeta__lamina">
      <div class="tarjeta__imagen">
        <Image
          src={ficha.portada}
          alt={ficha.portadaAlt}
          widths={[480, 800, 1200]}
          sizes={compacta ? '(max-width: 36rem) 100vw, 22rem' : '(max-width: 48rem) 100vw, 50vw'}
          loading={prioridad ? 'eager' : 'lazy'}
        />
      </div>
      <div class="tarjeta__rotulo">
        <h3>{ficha.titulo}</h3>
        <span class="tarjeta__anio">{ficha.anio}</span>
      </div>
    </div>
    <p class="tarjeta__resumen">{ficha.resumen}</p>
  </a>
  <ul class="tarjeta__datos nota">
    {ficha.datos.map((d) => <li>{d}</li>)}
    {ficha.con3d && <li class="con-3d">3D</li>}
  </ul>
</article>

<style>
  .tarjeta {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .tarjeta__enlace {
    color: inherit;
    text-decoration: none;
    display: grid;
    gap: 1rem;
  }
  .tarjeta__lamina {
    border: var(--trazo-grueso) solid var(--lamina-fondo);
    background: var(--lamina-fondo);
    color: var(--lamina-tinta);
  }
  .tarjeta__imagen {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--trazo) solid var(--lamina-tinta);
  }
  .tarjeta__imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--lamina-fondo-2);
    transition: transform 0.5s ease;
  }
  .tarjeta__rotulo {
    display: grid;
    grid-template-columns: 1fr auto;
  }
  h3 {
    font-size: var(--t-3);
    padding: 0.7rem 0.9rem;
  }
  .tarjeta__anio {
    border-left: var(--trazo) solid var(--lamina-tinta);
    padding: 0.7rem 0.9rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
  }
  .tarjeta__enlace:hover .tarjeta__lamina,
  .tarjeta__enlace:focus-visible .tarjeta__lamina {
    border-color: var(--tinta);
  }
  .tarjeta__enlace:hover h3 {
    color: #5f5e5a;
  }
  .tarjeta__enlace:hover .tarjeta__imagen :global(img) {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta__imagen :global(img) {
      transition: none;
    }
  }
  .tarjeta__resumen {
    margin: 0;
    color: var(--tinta-suave);
  }
  .tarjeta__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tarjeta__datos li {
    border: var(--trazo) solid var(--linea);
    padding: 0.1rem 0.5rem;
  }
  /* Ficha de un grupo (Ingeniería inversa): otras láminas asoman detrás */
  .tarjeta--grupo .tarjeta__lamina {
    box-shadow: 7px -7px 0 -1px #c2c1bc, 14px -14px 0 -2px #adaca7;
    margin-right: 14px;
  }
  /* Tarjeta pequeña: rótulo y resumen más pequeños */
  .tarjeta--compacta h3 {
    font-size: var(--t-2);
    padding: 0.55rem 0.75rem;
  }
  .tarjeta--compacta .tarjeta__anio {
    padding: 0.55rem 0.75rem;
  }
  .tarjeta--compacta .tarjeta__resumen {
    font-size: var(--t-0);
  }
  .tarjeta__datos .con-3d {
    border-color: var(--azul);
    color: var(--azul);
    font-weight: 650;
  }
</style>
