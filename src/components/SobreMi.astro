---
import { persona, sobreMi } from '../config';
import { t, type Lang } from '../i18n';
import Icono from './Icono.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = t(lang);
---

<section class="seccion" id="sobre-mi" aria-labelledby="sobre-mi-t">
  <div class="contenedor rejilla">
    <h2 id="sobre-mi-t" class="titulo-seccion">{tx.sobreMiTitulo}</h2>
    <div class="texto">
      {sobreMi[lang].map((p, i) => <p class={i === 0 ? 'primero' : ''}>{p}</p>)}
      {persona.cv && (
        <a class="boton" href={persona.cv} download>
          <Icono nombre="descarga" />
          {tx.descargarCv}
        </a>
      )}
    </div>
    <aside class="programas" aria-labelledby="programas-t">
      <h3 id="programas-t" class="nota">{tx.programasTitulo}</h3>
      <ul>
        {persona.programas.map((p) => <li>{p}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 4rem;
  }
  @media (min-width: 56rem) {
    .rejilla {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  h2 {
    grid-column: 1 / -1;
  }
  .texto p {
    font-size: var(--t-2);
    line-height: 1.5;
  }
  .texto .primero {
    font-size: var(--t-3);
    font-stretch: 105%;
    font-weight: 500;
    line-height: 1.3;
  }
  .programas h3 {
    font-size: var(--t-0);
    font-stretch: 80%;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .programas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--trazo-grueso) solid var(--tinta);
  }
  .programas li {
    border-bottom: var(--trazo) solid var(--linea);
    padding: 0.55rem 0;
    font-weight: 650;
    font-stretch: 112%;
  }
  /* Sigue la banda y vuelve a fundirse en el carbón antes de Contacto */
  #sobre-mi {
    position: relative;
    isolation: isolate;
  }
  #sobre-mi::before {
    content: '';
    position: absolute;
    inset: 0 0 -6rem;
    z-index: -1;
    background: linear-gradient(to bottom, var(--banda) 0%, var(--banda) 45%, var(--papel) 100%);
  }
</style>
