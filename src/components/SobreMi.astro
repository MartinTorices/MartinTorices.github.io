---
import { persona, sobreMi } from '../config';
import { t, type Lang } from '../i18n';
import Icono from './Icono.astro';
import { Image } from 'astro:assets';
import foto from '../assets/foto-martin.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = t(lang);
---

<section class="seccion" id="sobre-mi" aria-labelledby="sobre-mi-t">
  <div class="contenedor rejilla">
    <h2 id="sobre-mi-t" class="titulo-seccion" data-aparecer>{tx.sobreMiTitulo}</h2>
    <!-- foto en grises cálidos (sacada del CV), con marcas de esquina como en una lámina -->
    <figure class="foto" data-aparecer style="--retraso:0.25s">
      <Image src={foto} alt={tx.fotoAlt} width={400} widths={[400]} sizes="(min-width: 56rem) 18rem, 16rem" />
    </figure>
    <div class="texto" data-aparecer style="--retraso:0.15s">
      {sobreMi[lang].map((p, i) => <p class={i === 0 ? 'primero' : ''}>{p}</p>)}
      {persona.cv && (
        <a class="boton" href={persona.cv} download>
          <Icono nombre="descarga" />
          {tx.descargarCv}
        </a>
      )}
    </div>
    <!-- programas y taller, en dos columnas bajo el texto -->
    <div class="listas" data-aparecer style="--retraso:0.3s">
      <section class="programas" aria-labelledby="programas-t">
        <h3 id="programas-t" class="nota">{tx.programasTitulo}</h3>
        <ul>
          {persona.programas.map((p) => <li>{p}</li>)}
        </ul>
      </section>
      <section class="programas" aria-labelledby="taller-t">
        <h3 id="taller-t" class="nota">{tx.tallerTitulo}</h3>
        <ul>
          {persona.taller[lang].map((p) => <li>{p}</li>)}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 4rem;
  }
  @media (min-width: 56rem) {
    .rejilla {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  h2 {
    grid-column: 1 / -1;
  }
  .texto p {
    font-size: var(--t-2);
    line-height: 1.5;
  }
  .texto .primero {
    font-size: var(--t-3);
    font-stretch: 105%;
    font-weight: 500;
    line-height: 1.3;
  }
  /* En pantallas anchas: texto y listas a la izquierda, la foto sola a la derecha.
     En el móvil, la foto va antes del texto. */
  @media (min-width: 56rem) {
    .foto {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
    .texto,
    .listas {
      grid-column: 1;
    }
  }
  .listas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 2rem 3rem;
    margin-top: 1rem;
  }
  .foto {
    position: relative;
    margin: 0;
    max-width: 16rem;
    padding: 0.5rem;
  }
  @media (min-width: 56rem) {
    .foto { max-width: 18rem; margin-top: 0.25rem; }
  }
  .foto img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  /* marcas de esquina: el encuadre de una lámina */
  .foto::before,
  .foto::after {
    content: '';
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid var(--azul);
  }
  .foto::before {
    top: 0;
    left: 0;
    border-top-width: var(--trazo-grueso);
    border-left-width: var(--trazo-grueso);
  }
  .foto::after {
    right: 0;
    bottom: 0;
    border-right-width: var(--trazo-grueso);
    border-bottom-width: var(--trazo-grueso);
  }
  .programas h3 {
    font-size: var(--t-0);
    font-stretch: 80%;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .programas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--trazo-grueso) solid var(--tinta);
  }
  .programas li {
    border-bottom: var(--trazo) solid var(--linea);
    padding: 0.55rem 0;
    font-weight: 650;
    font-stretch: 112%;
  }
  /* Sigue la banda y vuelve a fundirse en el carbón antes de Contacto */
  #sobre-mi {
    position: relative;
    isolation: isolate;
  }
  #sobre-mi::before {
    content: '';
    position: absolute;
    inset: 0 0 -6rem;
    z-index: -1;
    background: linear-gradient(to bottom, var(--banda) 0%, var(--banda) 45%, var(--papel) 100%);
  }
</style>
